# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Trained weights / experiment artifacts
checkpoints/
runs/

# SpikeSkip & CUDA engine build artifacts (JIT-compiled on import)
*_cuda_engine*.so
*_cuda_engine*.pyd
*_cuda_engine*.dll
__pypackages__/

# Precompiled engines bundled into wheels by setup.py (regenerated per build)
spikestack_lite/_engine/*.pyd
spikestack_lite/_engine/*.so
spikestack_lite/_engine/*.dll

# Training logs
*.log

# Data (auto-downloads to ./data)
data/